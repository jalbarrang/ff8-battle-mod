{
  "name": "ff8-battle-mod",
  "version": "1.0.0",
  "private": true,
  "description": "External enemy/party HP display for Final Fantasy VIII (2013 Steam). Reads FF8_EN.exe memory only; no network access.",
  "author": "dw1284 (original author); locally hardened build",
  "main": "index.js",
  "build": {
    "appId": "ff8-battle-mod",
    "productName": "FF8 Battle HP",
    "npmRebuild": false,
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "index.js",
      "src/**/*",
      "scripts/**/*",
      "public/**/*",
      "!**/*.log",
      "!test-mem*",
      "!BUILD-NOTES.md",
      "!launch.cmd"
    ],
    "asarUnpack": [
      "**/node_modules/memoryjs/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "FF8-Battle-HP-${version}-portable.${ext}"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@rollup/plugin-commonjs": "^17.0.0",
    "@rollup/plugin-node-resolve": "^11.0.0",
    "electron": "^13.1.4",
    "electron-builder": "^22.11.7",
    "rollup": "^2.3.4",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.0.0",
    "rollup-plugin-terser": "^7.0.0",
    "svelte": "^3.0.0"
  },
  "dependencies": {
    "memoryjs": "^3.4.0"
  }
}
